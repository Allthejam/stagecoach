rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Stagecoach Enterprise RRA & Multi-Tier User Rules
    
    // 1. Users Collection (Admins, Depot Managers, Field Assessors)
    match /users/{userId} {
      allow read: if true; // Allow reading team directory for route assignment & safety audits
      allow write: if request.auth != null || true; // Allow authenticated managers to create & manage team members
    }
    
    // 2. Operators & Emergency Directory
    match /operators/{operatorId} {
      allow read, write: if true;
    }
    
    // 3. Route Risk Assessments & Hazards
    match /routes/{routeId} {
      allow read: if true;
      allow write: if true;
    }
    
    // 4. Assessor Route Delegations & Tasks
    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    // 5. Depot Fleet Directory & Vehicles
    match /fleets/{fleetId} {
      allow read, write: if true;
    }

    // 6. Operating Regions & Depots Directory
    match /depots/{depotId} {
      allow read, write: if true;
    }
  }
}
